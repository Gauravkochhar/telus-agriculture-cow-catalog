{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"platform": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss",
					"standalone": false
				},
				"@schematics/angular:directive": {
					"standalone": false
				},
				"@schematics/angular:pipe": {
					"standalone": false
				}
			},
			"root": "projects/platform",
			"sourceRoot": "projects/platform/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "ngx-build-plus:browser",
					"options": {
						"outputPath": "dist/platform",
						"index": "projects/platform/src/index.html",
						"polyfills": [
							"zone.js"
						],
						"tsConfig": "projects/platform/tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/platform/public",
								"output": "."
							}
						],
						"styles": [
							"projects/core/src/lib/styles/_global.scss",
							"projects/platform/src/styles.scss"
						],
						"scripts": [],
						"main": "projects/platform/src/main.ts",
						"extraWebpackConfig": "projects/platform/webpack.config.js",
						"commonChunk": false,
						"stylePreprocessorOptions": {
							"includePaths": [
								"projects/core/src/lib/styles"
							]
						}
					},
					"configurations": {
						"production": {
							"fileReplacements": [
								{
									"replace": "projects/platform/src/environments/environment.ts",
									"with": "projects/platform/src/environments/environment.prod.ts"
								}
							],
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all",
							"extraWebpackConfig": "projects/platform/webpack.prod.config.js"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						},
						"staging": {
							"fileReplacements": [
								{
									"replace": "projects/platform/src/environments/environment.ts",
									"with": "projects/platform/src/environments/environment.stag.ts"
								}
							],
							"optimization": true,
							"sourceMap": true,
							"extractLicenses": true,
							"outputHashing": "all",
							"extraWebpackConfig": "projects/platform/webpack.prod.config.js"
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "ngx-build-plus:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "platform:build:production",
							"extraWebpackConfig": "projects/platform/webpack.prod.config.js"
						},
						"development": {
							"buildTarget": "platform:build:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4200,
						"publicHost": "http://localhost:4200",
						"extraWebpackConfig": "projects/platform/webpack.config.js"
					}
				},
				"extract-i18n": {
					"builder": "@angular-devkit/build-angular:extract-i18n"
				},
				"test": {
					"builder": "@angular-devkit/build-angular:karma",
					"options": {
						"polyfills": [
							"zone.js",
							"zone.js/testing"
						],
						"tsConfig": "projects/platform/tsconfig.spec.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/platform/public"
							}
						],
						"styles": [
							"projects/platform/src/styles.scss"
						],
						"scripts": []
					}
				}
			}
		},

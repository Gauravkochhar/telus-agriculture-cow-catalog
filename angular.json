{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "cow-shell": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": false
        },
        "@schematics/angular:directive": {
          "standalone": false
        },
        "@schematics/angular:pipe": {
          "standalone": false
        }
      },
      "root": "projects/cow-shell",
      "sourceRoot": "projects/cow-shell/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "ngx-build-plus:browser",
          "options": {
            "outputPath": "dist/cow-shell",
            "index": "projects/cow-shell/src/index.html",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/cow-shell/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/cow-shell/public",
                "output": "."
              }
            ],
            "styles": ["projects/cow-shell/src/styles.scss"],
            "scripts": [],
            "main": "projects/cow-shell/src/main.ts",
            "extraWebpackConfig": "projects/cow-shell/webpack.config.js",
            "commonChunk": false
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "projects/cow-shell/src/environments/environment.ts",
                  "with": "projects/cow-shell/src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "extraWebpackConfig": "projects/cow-shell/webpack.prod.config.js"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "staging": {
              "fileReplacements": [
                {
                  "replace": "projects/cow-shell/src/environments/environment.ts",
                  "with": "projects/cow-shell/src/environments/environment.stag.ts"
                }
              ],
              "optimization": true,
              "sourceMap": true,
              "extractLicenses": true,
              "outputHashing": "all",
              "extraWebpackConfig": "projects/cow-shell/webpack.prod.config.js"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "ngx-build-plus:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "cow-shell:build:production",
              "extraWebpackConfig": "projects/cow-shell/webpack.prod.config.js"
            },
            "staging": { "buildTarget": "cow-shell:build:staging" },
            "development": { "buildTarget": "cow-shell:build:development" }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4200,
            "publicHost": "http://localhost:4200",
            "extraWebpackConfig": "projects/cow-shell/webpack.config.js"
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "projects/cow-shell/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/cow-shell/public"
              }
            ],
            "styles": ["projects/cow-shell/src/styles.scss"],
            "scripts": []
          }
        }
      }
    },

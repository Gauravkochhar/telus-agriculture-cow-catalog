{
  "name": "cow-catalog-mf",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:shell:dev": "ng serve cow-shell --configuration development --port 4200",
    "start:catalog:dev": "ng serve cow-catalog --configuration development --port 4201",
    "start:detail:dev": "ng serve cow-detail --configuration development --port 4202",
    "start:all": "concurrently \"npm:start:shell:dev\" \"npm:start:catalog:dev\" \"npm:start:detail:dev\"",
    "dev:shell:build:watch": "ng build cow-shell --watch --configuration development --verbose",
    "dev:catalog:build:watch": "ng build cow-catalog --watch --configuration development --verbose",
    "dev:detail:build:watch": "ng build cow-detail --watch --configuration development --verbose",
    "dev:all": "concurrently \"npm:dev:shell:build:watch\" \"npm:dev:catalog:build:watch\" \"npm:dev:detail:build:watch\"",
    "stg:shell:build": "ng build cow-shell --configuration staging --output-path=dist/cow-shell-staging --delete-output-path",
    "stg:catalog:build": "ng build cow-catalog --configuration staging --output-path=dist/cow-catalog-staging --delete-output-path",
    "stg:detail:build": "ng build cow-detail --configuration staging --output-path=dist/cow-detail-staging --delete-output-path",
    "prod:shell:build": "ng build cow-shell --configuration production --output-path=dist/cow-shell-prod --delete-output-path",
    "prod:catalog:build": "ng build cow-catalog --configuration production --output-path=dist/cow-catalog-prod --delete-output-path",
    "prod:detail:build": "ng build cow-detail --configuration production --output-path=dist/cow-detail-prod --delete-output-path",
    "run:all": "node node_modules/@angular-architects/module-federation/src/server/mf-dev-server.js",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-architects/module-federation": "^19.0.3",
    "@angular-devkit/build-angular": "^19.2.17",
    "@angular/cli": "^19.2.17",
    "@angular/compiler-cli": "^19.2.0",
    "@types/jasmine": "~5.1.0",
    "concurrently": "^9.2.1",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ngx-build-plus": "^19.0.0",
    "typescript": "~5.7.2"
  }
}

{
  "name": "cow-catalog-mf",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "test": "ng test",
    "lint": "ng lint",
    "core:build": "ng build core",
    
    "start:all": "concurrently \"npm run start:host:platform:dev\" \"npm run start:mfe:catalog:dev\" \"npm run start:mfe:detail:dev\"",
    "dev:all": "concurrently \"npm run dev:host:platform:build:watch\" \"npm run dev:mfe:catalog:build:watch\" \"npm run dev:mfe:detail:build:watch\"",
    "run:all": "node node_modules/@angular-architects/module-federation/src/server/mf-dev-server.js",
    
    "start:host:platform:dev": "ng serve platform --configuration development --port 4200",
    "start:mfe:catalog:dev": "ng serve cow-catalog --configuration development --port 4201",
    "start:mfe:detail:dev": "ng serve cow-detail --configuration development --port 4202",
    
    "dev:host:platform:build:watch": "ng build platform --watch --configuration development --verbose",
    "dev:mfe:catalog:build:watch": "ng build cow-catalog --watch --configuration development --verbose",
    "dev:mfe:detail:build:watch": "ng build cow-detail --watch --configuration development --verbose",
    
    "prod:host:platform:build": "ng build platform --configuration production --output-path=dist/platform-prod --delete-output-path",
    "prod:mfe:catalog:build": "ng build cow-catalog --configuration production --output-path=dist/cow-catalog-prod --delete-output-path",
    "prod:mfe:detail:build": "ng build cow-detail --configuration production --output-path=dist/cow-detail-prod --delete-output-path",
    
    "prod:gh:host:platform:build": "ng build platform --configuration production --output-path=dist/gh-pages --base-href '/telus-agriculture-cow-catalog/'",
    "prod:gh:mfe:catalog:build": "ng build cow-catalog --configuration production --output-path=dist/gh-pages/cow-catalog --base-href '/telus-agriculture-cow-catalog/cow-catalog/'",
    "prod:gh:mfe:detail:build": "ng build cow-detail --configuration production --output-path=dist/gh-pages/cow-detail --base-href '/telus-agriculture-cow-catalog/cow-detail/'",
    
    "gh:clear:cache": "rm -rf node_modules/.cache/gh-pages",
    "deploy:all": "gh-pages -d dist/gh-pages",
    
    "build:all:prod": "npm run prod:host:platform:build && npm run prod:mfe:catalog:build && npm run prod:mfe:detail:build"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.4",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@primeng/themes": "^20.2.0",
    "bootstrap": "^4.6.2",
    "primeicons": "^6.0.1",
    "primeng": "^19.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-architects/module-federation": "^19.0.3",
    "@angular-devkit/build-angular": "^19.2.17",
    "@angular/cli": "^19.2.17",
    "@angular/compiler-cli": "^19.2.0",
    "@types/jasmine": "~5.1.0",
    "concurrently": "^9.2.1",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^19.2.0",
    "ngx-build-plus": "^19.0.0",
    "typescript": "~5.7.2"
  }
}
